+def compute_norm_constants(energies, pos_scale=POS_SCALE):
+    """normalize_hits() constants of a training split: mean and std of log10(E [GeV]) over all its hits.
+
+    Args:
+        energies: iterable of hit-energy arrays (GeV), e.g. one per event or per file; clipped at E_FLOOR.
+    """
+    import numpy as np
+    log_e = [np.log10(np.clip(np.asarray(e, dtype=np.float64), E_FLOOR, None)) for e in energies]
+    n = sum(len(v) for v in log_e)
+    mean = sum(v.sum() for v in log_e) / n
+    std = np.sqrt(sum(((v - mean) ** 2).sum() for v in log_e) / n)
+    return {"log_e_mean": float(mean), "log_e_std": float(std), "pos_scale": float(pos_scale)}
