+def normalize_hits(pc, log_e_mean=LOG_E_MEAN, log_e_std=LOG_E_STD, pos_scale=POS_SCALE):
+    """Map (N, 4) [E, x, y, z] to [standardized log10(E), [x, y, z] / pos_scale]."""
