     return out
 
 
+def log10_mean_std(arrays, floor=E_FLOOR):
+    """(count, mean, population std) of log10(max(a, floor)) over every value of an iterable of arrays.
+
+    One float64 pass that merges per-array moments (Chan et al.), so it streams over events.
+    """
+    n, mean, m2 = 0, 0.0, 0.0
+    for a in arrays:
+        v = np.log10(np.maximum(np.asarray(a, dtype=np.float64), floor))
+        if v.size == 0:
+            continue
+        nb, mb = v.size, float(v.mean())
+        delta, total = mb - mean, n + nb
+        mean += delta * nb / total
+        m2 += float(((v - mb) ** 2).sum()) + delta * delta * n * nb / total
+        n = total
+    std = (m2 / n) ** 0.5 if n else float("nan")
+    return n, mean, std
+
+
+def compute_norm_constants(energies, e_floor=E_FLOOR, pos_scale=POS_SCALE):
+    """normalize_hits() constants from data: mean / std of log10(E [GeV]) over all hits, E clipped at e_floor.
+
+    energies: iterable of per-event hit-energy arrays in GeV (e.g. the training split).
+    Returns {"LOG_E_MEAN", "LOG_E_STD", "POS_SCALE", "N_HITS"}.
+    """
+    n, mean, std = log10_mean_std(energies, floor=e_floor)
+    return {"LOG_E_MEAN": mean, "LOG_E_STD": std, "POS_SCALE": pos_scale, "N_HITS": n}
+
